# 모의 Ollama 시험용 설정 (실제 주소·키 없음)
# 1) python tools/mock_ollama.py --port 11436
# 2) python server.py --port 8800 --env tools/mock_ollama.env   → http://127.0.0.1:8800/
# 시나리오 바꾸기: POST http://127.0.0.1:11436/_scenario {"name": "oom"}  (tools/mock_ollama.py 맨 위 설명 참고)
OLLAMA_BASE_URL=http://127.0.0.1:11436
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODEL_ROADMAP=growpath-roadmap:9b
OLLAMA_EMBED_MODEL=bge-m3
# 시간 초과 시나리오를 빨리 보려고 짧게 둠 (실제 RunPod 기본값은 180초)
OLLAMA_TIMEOUT=8
# 기획서 이미지를 볼 모의 비전 모델 (실제 모델 아님)
OLLAMA_VISION_MODEL=qwen2.5vl:7b
