# GrowPath 4차 목업 (Claude) · AI 모델 설정 예시
# - 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 채우세요.
#   (PowerShell: Copy-Item .env.example .env)
# - .env 는 server.py 만 읽습니다. 키·주소를 HTML·JS 파일에 복사하지 마세요.
# - 화면 왼쪽 메뉴 아래 'AI 모델'에서 RunPod-Ollama / OpenAI API 중 하나를 고릅니다.
#   고른 모드가 설정되지 않았으면 가데이터로 보여 줍니다(키·주소가 없어도 모든 화면을 볼 수 있음).
# - 값을 바꾼 뒤에는 서버(목업_실행.cmd)를 다시 실행하세요.

# ── RunPod-Ollama (로컬 LLM·sLLM) ──
# Pod 의 Ollama 포트(11434)를 HTTP 로 연 RunPod 프록시 주소. 비우면 RunPod-Ollama 를 쓸 수 없음
#   형식 예시(가짜 Pod ID): https://abcd1234efgh56-11434.proxy.runpod.net
#   로컬 Ollama 면 http://127.0.0.1:11434
OLLAMA_BASE_URL=

# 진단·규정·보고서 에이전트가 쓰는 기본 모델 (Ollama 모델 이름 · 예시)
OLLAMA_MODEL=qwen3.5:9b

# 로드맵 하위 에이전트(A1·A2·A3)가 쓰는 모델. 비우면 OLLAMA_MODEL 을 씀 (예: LoRA 어댑터를 붙인 sLLM)
OLLAMA_MODEL_ROADMAP=

# 규정 RAG 검색용 임베딩 모델. 비우면 RunPod-Ollama 모드의 규정 검색은 키워드 검색으로 함
OLLAMA_EMBED_MODEL=

# 선택: 기획서 속 이미지(그림·도표)를 볼 비전 모델 (예: qwen2.5vl:7b). 비우면 이미지는 읽지 않고 개수만 알림
OLLAMA_VISION_MODEL=

# 응답을 기다리는 최대 시간(초). 첫 호출은 모델을 GPU에 올리느라 오래 걸릴 수 있음
# (RunPod HTTP 프록시는 약 100초가 지나면 524 로 끊을 수 있음)
OLLAMA_TIMEOUT=180

# 선택: 문맥 길이, 모델을 GPU에 남겨 둘 시간(예: 30m), 프록시 앞에 인증을 둔 경우의 키
#   사내 생활 도우미는 앞 대화 전체를, 기획서 요약은 문서 앞 6,000자를 보내므로 문맥 길이를 넉넉히(예: 16384) 두는 것이 좋습니다
OLLAMA_NUM_CTX=
OLLAMA_KEEP_ALIVE=
OLLAMA_API_KEY=

# ── OpenAI API ──
OPENAI_API_KEY=

# 대화·문항 생성·진단·로드맵 작성·규정 답변에 쓰는 모델
# 사용 중인 API에서 제공하는 실제 모델 ID를 입력하세요.
OPENAI_MODEL=

# 규정 RAG 검색용 임베딩 모델
OPENAI_EMBED_MODEL=text-embedding-3-small

# 선택: 기획서 속 이미지를 볼 모델(이미지 입력을 지원하는 모델만). 비우면 이미지는 읽지 않고 개수만 알림
OPENAI_VISION_MODEL=

# 기본 주소를 바꿔야 할 때만 사용 (프록시 등)
OPENAI_BASE_URL=https://api.openai.com/v1

# 모델이 JSON 응답 형식(response_format)을 지원하지 않아 오류가 나면 off 로 바꾸세요
OPENAI_JSON_MODE=on
