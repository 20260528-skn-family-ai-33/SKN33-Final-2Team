# GrowPath 통합 개발 환경 · 설정 예시 (값은 모두 가짜)
# 복사해서 이름을 .env 로 바꾼 뒤 고쳐 쓰세요. .env 는 Git·공유물에 넣지 않습니다(.gitignore).
# docker compose 가 이 파일을 읽어 참고용 백엔드 컨테이너에 넘겨요(파이썬으로 직접 띄울 때는 GP5_ENV_FILE=../.env · backend/README.md).
# 화면(frontend) 개발 설정은 frontend/.env.example 을 보세요.

# ── Docker 이름·포트 (같은 PC의 다른 환경과 겹치지 않게) ──
COMPOSE_PROJECT_NAME=growpath
# 화면(nginx · docker compose up 으로 켰을 때) → http://localhost:8816/
WEB_PORT=8816
# 참고용 백엔드 API → http://localhost:8815/api/docs (5차 옛 화면도 http://localhost:8815/ 에서 비교용으로 열림)
BACKEND_PORT=8815

# ── DB (docker compose 의 db 서비스) ──
GP5_DB_NAME=growpath
GP5_DB_USER=growpath
# 비밀번호는 여기 한 곳에만. DB를 처음 만들기 전에 정하세요(만든 뒤 바꾸면 DB 쪽은 그대로라 연결이 안 됨)
GP5_DB_PASSWORD=change-this-local-password
# 이 PC에서 DB에 직접 붙을 때의 포트(127.0.0.1 에만 열림)
GP5_DB_PORT=55465
# 비워 두면 위 값으로 로컬 Docker DB에 붙어요. 다른 DB를 쓸 때만 적어요(컨테이너 안에서는 compose 가 db 주소로 덮어씀)
DATABASE_URL=
# 빈 DB를 처음 채울 팀 DB 전체 백업 — team_db/ 폴더에 넣은 파일 이름
TEAM_DB_FILE=growpath_latest.dump
# 로드맵 입력량 검사: 기본은 backend/tokenizer_assets/qwen38.json. Docker 빌드 때 고정 버전을 설치합니다.
# 호스트에서 별도 경로를 사용할 때만 지정하세요. 요청 중 다운로드하지 않습니다.
ROADMAP_TOKENIZER_PATH=
# (로컬 파이썬으로 setup_db 를 직접 돌릴 때만) backend 기준 백업 위치
TEAM_DB_DUMP=../team_db/growpath_latest.dump
# (로컬 파이썬으로 백엔드를 직접 돌릴 때만) 규정 원문 PDF 폴더(팀 규정 묶음의 source/ 가 들어 있는 곳) · 비우면 ../team_db/regulations
GP5_REGULATION_FILES_DIR=
GP5_DB_TIMEZONE=Asia/Seoul

# ── 참고용 백엔드 ──
# 로그인 쿠키 이름: 같은 브라우저로 여러 환경을 번갈아 열 때 로그인이 서로 덮이지 않게
GP5_SESSION_COOKIE=growpath_session
# 시연 초기 비밀번호(직원·관리자 공통 · 로컬 사본에만 적용 · 운영 금지)
# 공개 저장소라 값을 적지 않아요. 비워 두면 참고용 백엔드의 시연 기본값을 써요(값은 팀 안내 참고)
GP5_DEMO_PASSWORD=
GP5_ADMIN_LOGIN=admin

# ── RunPod-Ollama ──
# Pod 준비·키 잠금·모델 받기는 backend/RunPod_Ollama_연결_절차.md 를 따라요(아래 '절차 2-4' 등은 그 문서의 절 번호)
# Pod 주소: RunPod Connect → Direct TCP Ports 의 '<공개IP>:<외부포트> -> :11434' 줄을 http:// 로 적어요(예: http://203.0.113.10:22121 · https 아님)
OLLAMA_BASE_URL=
# Pod 의 키(Pod 안 /workspace/ollama_key.txt · 절차 2-6). 채팅·저장소에 붙이지 않아요
OLLAMA_API_KEY=
# 모델: 비워 두면 팀이 파인튜닝한 두 모델을 써요(코드 기본값 · backend/app/config.py · 팀 결정 2026-10-29)
#   진단·로드맵 에이전트 : growpath-27b           ← https://huggingface.co/Ssum-mer/qwen3.8-27b-growpath-Q4
#   규정 에이전트(사내 생활 도우미·안별 지원 조건): growpath-regulation-4b ← https://huggingface.co/golddragon0926/qwen35-4b-diagnosis-agent
#   Pod 에서 허깅페이스 모델을 받아 위 이름으로 만드는 법은 절차 2-4('팀 모델 받기' → '채팅 형식 붙이기')
# 원본 Qwen 과 비교할 때만 Pod 의 'ollama list' 이름을 적어요(예: OLLAMA_MODEL=qwen3.8:27b · Pod 에서 ollama pull 먼저 · 끝나면 다시 비움)
# 허깅페이스 이름(hf.co/…)은 적지 않아요(채팅 형식이 붙지 않은 상태라 확인하지 않은 구성)
OLLAMA_MODEL=
OLLAMA_MODEL_REGULATION=
# 기획서 이미지 읽기 모델: 팀 모델은 이미지 입력이 없어 비워 둬요(비우면 RunPod-Ollama 모드는 이미지 읽기를 건너뜀 · 원본 비교 때만 예: qwen3.8:27b)
OLLAMA_VISION_MODEL=
# 응답을 기다리는 최대 시간(초): 27B 모델의 첫 호출(모델 올리기)과 긴 로드맵 3안 작성을 고려해 300초(코드 기본값 180초)
OLLAMA_TIMEOUT=300
# 문맥 길이: Pod 의 OLLAMA_CONTEXT_LENGTH(절차 2-3)와 같게 둬요. 다르면 첫 호출 때 모델을 다시 불러와요
OLLAMA_NUM_CTX=16384
# 마지막 호출 뒤 모델을 GPU 에 올려 두는 시간
OLLAMA_KEEP_ALIVE=30m
# 생각(thinking) 모드·추론 정도 기본값(진단·로드맵 모델): off 면 생각 없이 바로 답해 빨라져요(on 은 켬). low 처럼 모델의 단계 이름도 돼요
# (실제 Pod 27b: 끔·low·medium·xhigh). 비우면 모델 기본값(켜짐) · 기본은 off · true·false 로 적으면 시작할 때 멈춰요
# 직원이 화면 좌측 'AI 모델'의 '추론 정도'에서 고르면 그 값이 앞서요(고를 단계는 연결 확인 때 모델에게 물어 정함 · /api/show)
# 규정 에이전트 모델(4b)은 생각을 끄고 학습해 이 값·화면과 관계없이 늘 끄고 불러요
OLLAMA_THINK=off

# ── OpenAI API ──
# 규정 검색 임베딩도 이 키로 해요. RunPod-Ollama 모드만 쓰더라도 키가 있어야 도우미가 규정을 찾아요(없으면 실패로 알림)
OPENAI_API_KEY=sk-example-not-a-real-key
OPENAI_MODEL=gpt-6-luna
# 규정 검색 임베딩: RunPod-Ollama·OpenAI 모드 공통(팀 합의) · 팀 DB 벡터와 같은 모델이어야 해요
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_JSON_MODE=on
# 로드맵 생성·재생성·수정만 HTTP 대기 제한을 늘려요(초, 1~600). 다른 OpenAI 호출은 기존 90초예요.
# 응답 속도를 높이는 설정은 아니며, 시간 초과 뒤 자동 재호출하지 않아요. 90으로 되돌릴 수 있어요.
OPENAI_ROADMAP_TIMEOUT=180
# 추론 정도(reasoning_effort): 직원은 화면 좌측 'AI 모델'의 '추론 정도'에서 모델이 받는 단계 안에서 골라요
# 비워 두면 기본 모델 gpt-6-luna 의 확인한 단계를 써요(코드 기본값 · backend/app/config.py): none·low·medium·high·xhigh, 모델 기본 medium.
# 이 앱은 Chat Completions 로 호출해서 모델 문서에 있는 max 는 400 으로 거부돼요(2026-10-28 실제 호출 오류 확인)
# OPENAI_MODEL 을 다른 모델로 바꿀 때만 그 모델이 받는 단계를 낮은 것부터 적어요(안 적으면 그 모델은 고르지 못함)
OPENAI_REASONING_LEVELS=
# 고르지 않은 직원의 기본값. 비우면 보내지 않아 모델 기본값을 따라요(화면에는 '기본값 · 보통'처럼 모델 기본값을 보여 줌)
OPENAI_REASONING_EFFORT=
