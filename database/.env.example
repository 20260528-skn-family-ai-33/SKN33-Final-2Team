# Copy to .env.local and set your own connection. The variable name is legacy;
# a Supabase service is not required for a local PostgreSQL connection.
SUPABASE_DB_URL=postgresql://postgres:EXAMPLE_PASSWORD@127.0.0.1:55433/growpath
POSTGRES_PASSWORD=EXAMPLE_PASSWORD
DB_SSLMODE=disable
# Optional folder containing PostgreSQL 17 executables on your own machine.
# POSTGRES_BIN_DIR=
# SOURCE_DB_URL=
# TARGET_DB_URL=

# Paid embeddings/search only; status and unit tests need no key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
REGULATION_RAG_INCLUDE_REVIEW=false
DATA_GO_KR_API_KEY=
KMOOC_SERVICE_KEY=
LIBRARY_AUTH_KEY=
LIBRARY_NARU_API_KEY=
CAREERNET_API_KEY=
