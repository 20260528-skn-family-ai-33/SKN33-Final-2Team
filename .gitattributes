# 제출 산출물의 원본 바이트를 보존하고 텍스트 공백 검사에서 제외한다.
*.pdf binary
*.docx binary
*.xlsx binary
*.xlsm binary

# Preserve applied migration and snapshot metadata checksums.
database/src/database/migrations/*.sql -text
database/data/exports/*.manifest.json -text
database/data/exports/pgvector_pg17_windows_x64/manifest.json -text
database/src/database/catalog*.json -text
docs/07_데이터베이스_저장소_설계/ERD_최종.html -text

# Import manifests hash exact bytes; preserve them on Windows and Linux checkout.
database/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/07_데이터베이스_저장소_설계/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/08_데이터_전처리_결과서/** -text
docs/09_벡터DB_구축_결과서/** -text
README.md -text
AGENTS.md -text
.gitignore -text
.gitattributes -text

# ── 화면(frontend) · 이슈 #20 ──
# 이 폴더만 줄 끝을 LF로 고정한다(Windows·Linux 체크아웃이 같은 파일이 되게). 저장소 전체 규칙은 바꾸지 않는다
frontend/** text=auto eol=lf

# ── 실행 환경(Docker) · 이슈 #20 ──
# Docker 안에서 쓰는 파일은 줄 끝을 LF로 고정한다
backend/** text=auto eol=lf
scripts/*.sh text eol=lf
docker-compose.yml text eol=lf
# 적용된 보조 스키마 SQL 은 바이트를 보존한다(database/ 마이그레이션 규칙과 같은 취지)
backend/db/*.sql -text
