# 화면 개발 설정 (값은 예시) — 복사해서 frontend/.env.local 로 두고 고쳐 쓰세요. .env.local 은 Git 에 넣지 않습니다.

# /api 요청을 넘길 백엔드 주소. 참고용 백엔드(docker compose 의 backend)는 http://localhost:8815
# 팀원 백엔드로 바꿀 때는 이 한 줄만 고치면 돼요(예: http://localhost:8000)
API_PROXY_TARGET=http://localhost:8815

# 개발 서버 포트(npm run dev → http://localhost:5185)
DEV_PORT=5185

# 처음에는 시연 도구를 숨깁니다. Ctrl+Alt+K에서 demo on으로 켤 수 있습니다.
# Docker Compose 빌드는 이 파일 대신 저장소 루트 .env의 VITE_DEMO_TOOLS를 사용합니다.
VITE_DEMO_TOOLS=off
