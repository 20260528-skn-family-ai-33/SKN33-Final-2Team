{
  "name": "growpath-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GrowPath 화면 (React + Vite + TypeScript) — 5차 목업 화면을 그대로 옮긴 것",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
