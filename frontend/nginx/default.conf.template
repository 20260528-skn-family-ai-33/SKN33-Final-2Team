# GrowPath 화면 nginx 설정 (컨테이너 시작 때 ${API_UPSTREAM} 을 채운다)
# 화면과 API 를 같은 주소로 내서 로그인 쿠키(SameSite=Lax)가 그대로 동작한다. AWS 에서는 이 앞에 HTTPS(로드밸런서·CloudFront)를 둔다.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # 관리자 엑셀·CSV(20MB까지)와 첨부 파일 올리기
    client_max_body_size 25m;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 작업 상태는 긴 요청(GET /jobs/{id}?wait=10)으로 기다리고, 모델 호출은 수십 초 걸릴 수 있다
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 빌드 파일은 이름에 내용 해시가 붙어 있어 오래 캐시해도 된다
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 화면 주소(/roadmaps/… 등)는 모두 index.html 로(React Router 가 화면을 고른다). index.html 은 캐시하지 않는다
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
